# api-hunting: lee loads y plantillas, registra y actualiza pods
API_HUNTING_URL=
API_HUNTING_KEY=

# Ejecución en las VMs (mismo mecanismo que orchestrator-local-deliverycategory)
VM_GUEST_PASSWORD_FILE=
VM_GUEST_USER=extractor
# Opcional: reemplaza el comando completo de ejecución en la VM (debe incluir {vm} y {cmd})
LOCAL_VM_EXEC_TEMPLATE=

# Cliente genérico de hunting
HUNTING_CLIENT_ID=412
# Hora de Chile desde la que no se lanza nada nuevo en el día
END_TIME=19:59

# Con cron se usa RUN_ONCE=true (un ciclo y termina); con pm2, LOOP_INTERVAL_MINUTES
RUN_ONCE=
LOOP_INTERVAL_MINUTES=10
