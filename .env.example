# api-hunting: lee loads y plantillas, y marca position_status/pricing_status en categories
API_HUNTING_URL=
API_HUNTING_KEY=

# Lectura de pm2 en las VMs (mismo mecanismo que orchestrator-local-deliverycategory)
VM_GUEST_PASSWORD_FILE=
VM_GUEST_USER=extractor
# Opcional: reemplaza el comando completo de ejecución en la VM (debe incluir {vm} y {cmd})
LOCAL_VM_EXEC_TEMPLATE=

# Con cron se usa RUN_ONCE=true (un ciclo y termina); con pm2, LOOP_INTERVAL_MINUTES
RUN_ONCE=
LOOP_INTERVAL_MINUTES=10
